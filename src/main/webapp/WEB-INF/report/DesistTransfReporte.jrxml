	<variable name="titulo_r" class="java.lang.String">
		<variableExpression><![CDATA["Resolución No. "+$F{resolucion}+" - "+(new java.util.Date().getYear() + 1900)+" - SENADI"]]></variableExpression>
	</variable>
	<variable name="no_solicitud" class="java.lang.String">
		<variableExpression><![CDATA[$F{solicitud}+", de fecha "+new SimpleDateFormat("dd 'de' MMMMM 'de' yyyy").format($F{fecha_solicitud})]]></variableExpression>
	</variable>
	<variable name="parrafo1" class="java.lang.String">
		<variableExpression><![CDATA["<style isBold='true' pdfFontName='Helvetica-Bold'>SERVICIO NACIONAL DE DERECHOS INTELECTUALES - SENADI, DIRECCIÓN TÉCNICA DE MODIFICACIONES AL REGISTRO.-</style>"+
" Quito, D.M., "+new SimpleDateFormat("dd 'de' MMMMM 'de' yyyy', a las 'HH':'mm").format(new Date())+".- Vistos: Que, "+$F{titular_actual}.replace("&","&amp;")+", "+
"mediante escrito ingresado con fecha "+new SimpleDateFormat("dd 'de' MMMMM 'de' yyyy").format($F{fecha_resolucion})+", en el cual se solicita el "+
"desistimiento de la solicitud de transferencia No. "+$F{solicitud}+", presentada el "+new SimpleDateFormat("dd 'de' MMMMM 'de' yyyy").format($F{fecha_solicitud})+
", relacionada a un "+$F{signo}+", con registro originario No. "+$F{titulo}+", de fecha "+new SimpleDateFormat("dd 'de' MMMMM 'de' yyyy").format($F{fecha_titulo})+
", con denominación "+$F{denominacion}+". En lo principal, esta Dirección, en ejercicio de la facultad atribuida por la Dirección Nacional de Propiedad Industrial "+
"mediante Acción de Personal "+$P{resol_label}+", y conforme a lo dispuesto en el artículo 211 del Código Orgánico Administrativo COA; "+
"<style isBold='true' pdfFontName='Helvetica-Bold'>RESUELVE: </style> Aceptar el desistimiento de la solicitud de transferencia "+$F{solicitud}+", presentada el "+
new SimpleDateFormat("dd 'de' MMMMM 'de' yyyy").format($F{fecha_solicitud})+", relacionada a un "+$F{signo}+" con registro originario No. "+$F{titulo}+", "+
"de fecha "+new SimpleDateFormat("dd 'de' MMMMM 'de' yyyy").format($F{fecha_titulo})+"; y, ordenar del expediente, conformado para el efecto.- "+
"<style isBold='true' pdfFontName='Helvetica-Bold'>NOTIFÍQUESE Y ARCHÍVESE.-</style>"]]></variableExpression>
	</variable>
	<variable name="parrafo2" class="java.lang.String">
		<variableExpression><![CDATA["<style isBold='true' pdfFontName='Helvetica-Bold'>RAZÓN:</style> Siento por tal que el día de hoy "+
"<style isBold='true' pdfFontName='Helvetica-Bold'>"+new SimpleDateFormat("dd 'de' MMMM 'de' yyyy").format(new Date())+"</style>, "+
"se notificó con la resolución que antecede a <style isBold='true' pdfFontName='Helvetica-Bold'>"+$F{titular_actual}.replace("&","&amp;")+"</style>, "+
"mediante boleta depositada en la casilla electrónica SENADI No. <style isBold='true' pdfFontName='Helvetica-Bold'>"+$F{casillero_senadi}+"</style>, "+
"Lo que certifico, en virtud de la delegación de la Directora de Gestión Institucional conferida mnediante Resolución "+$P{resol_label}+"."]]></variableExpression>
	</variable>
	<variable name="registro_titulo" class="java.lang.String">
		<variableExpression><![CDATA[$F{titulo}+" de "+new SimpleDateFormat("dd 'de' MMMMM 'de' yyyy").format($F{fecha_titulo})]]></variableExpression>
	</variable>
