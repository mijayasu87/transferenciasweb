	</variable>
	<variable name="inicio" class="java.lang.String">
		<variableExpression><![CDATA["\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0"+
"\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0"+
"\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0"+
"\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0"+
"\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0"+
"\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0"+
"\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0"+
"\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0"+
"\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0"+
" Quito, "+new SimpleDateFormat("dd 'de' MMMM 'de' yyyy",new Locale("es", "ES")).format($F{fecha_elabora_notificacion})+".- Esta Unidad administrativa comunica a usted que no ha presentado con la solicitud de transferencia lo siguiente:"]]></variableExpression>
	</variable>
	<variable name="fin" class="java.lang.String">
		<variableExpression><![CDATA["Razón: Siento por tal que el día de hoy "+new SimpleDateFormat("dd 'de' MMMM 'de' yyyy",new Locale("es", "ES")).format(new Date())+
" notifiqué con la providencia que antecede a "+$F{titular_actual}
+", mediante boleta depositada en la casilla SENADI/JUDICIAL y/o correo electrónico "+$F{casillero_senadi}+
""+$F{casillero_judicial}+", correspondiente a su apoderado/a.- Lo que certifico."]]></variableExpression>
	</variable>
	<variable name="centro" class="java.lang.String">
		<variableExpression><![CDATA["Cúmplase con lo dispuesto en ésta providencia dentro del plazo de dos meses, vencido el cual, de no atenderse lo solicitado, se producirá el abandono del procedimiento, ordenándose el archivo del expediente respectivo, de conformidad con el artículo 212 del Código Orgánico Administrativo.  El presente acto administrativo se emite en ejercicio de la facultad delegada por la Dirección Nacional de Propiedad Industrial, mediante resolución No.002-2019-DNPI-SENADI  de 31 de Enero de 2019."+"<b>"+" Notifíquese.- f) Ab. Franklin Jara Patiño., DELEGADO DEL DIRECTOR NACIONAL DE PROPIEDAD INDUSTRIAL."+"</b>"]]></variableExpression>
	</variable>
