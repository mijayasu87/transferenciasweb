	<variable name="parrafo_1" class="java.lang.String">
		<variableExpression><![CDATA["<style pdfFontName='Times-Bold'>DIRECCIÓN TÉCNICA DE MODIFICACIONES AL REGISTRO.-</style> Quito, "+
new SimpleDateFormat("dd 'de' MMMMM 'de' yyyy",new Locale("es", "ES")).format($F{fecha_notificacion})+
". Las 11h00.- Esta Unidad administrativa comunica a usted uso lo siguiente: "]]></variableExpression>
	</variable>
	<variable name="parrafo_2" class="java.lang.String">
		<variableExpression><![CDATA["Cúmplase con lo dispuesto en ésta providencia dentro del término de diez días, de no "+
"atenderse lo solicitado, se producirá el abandono del procedimiento, ordenándose el archivo "+
"del expediente respectivo, de conformidad con el artículo 51 del Reglamento del Código Orgánico "+
"Administrativo. El presente acto administrativo se emite en ejercicio de la facultad conferida mediante Acción de Personal "+
$P{resolucionpren}+". <style pdfFontName='Times-Bold'>Notifíquese.- "+
$P{delegado}+", "+$P{delegacion}+"</style>.\n\n\n"+
"Lo que certifico, en virtud "+
"de la delegación de la Directora Nacional Encargada, conferida mediante Resolución Nro. "+$P{resolucionnot}+"."]]></variableExpression>
	</variable>
