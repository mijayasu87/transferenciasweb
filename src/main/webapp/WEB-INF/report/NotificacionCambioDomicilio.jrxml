	<variable name="solicitud_n" class="java.lang.String">
		<variableExpression><![CDATA[$F{solicitud}+" - ("+new SimpleDateFormat("dd 'de' MMMMM 'de' yyyy").format($F{fecha_presentacion})+")"]]></variableExpression>
	</variable>
	<variable name="notificacion_n" class="java.lang.String">
		<variableExpression><![CDATA[$F{notificacion}+"-2022"]]></variableExpression>
	</variable>
	<variable name="registro_n" class="java.lang.String">
		<variableExpression><![CDATA[$F{registro}+" - ("+new SimpleDateFormat("dd 'de' MMMMM 'de' yyyy").format($F{fecha_registro})+")("+$F{signo}+")"]]></variableExpression>
	</variable>
	<variable name="parrafo_1" class="java.lang.String">
		<variableExpression><![CDATA["<style pdfFontName='Times-Bold'>DIRECCIÓN TÉCNICA DE MODIFICACIONES AL REGISTRO.-</style>"+
" Quito, "+new SimpleDateFormat("dd 'de' MMMMM 'de' yyyy").format($F{fecha_notificacion})+
". Las 11h00.- Esta Unidad administrativa comunica a usted que no ha presentado con la solicitud de Cambio de Domicilio lo siguiente: "]]></variableExpression>
	</variable>
	<variable name="parrafo_2" class="java.lang.String">
		<variableExpression><![CDATA["Cúmplase con lo dispuesto en ésta providencia dentro del término de diez días, de no atenderse lo solicitado, "+
"se producirá el abandono del procedimiento, ordenándose el archivo del expediente respectivo, de conformidad con "+
"el artículo 51 del Reglamento de Gestión de los Conocimientos. El presente acto administrativo se emite en "+
"ejercicio de la facultad conferida mediante Acción de Personal "+
"Nro. "+$P{resoluciontransf}+". <style pdfFontName='Times-Bold'>Notifíquese.- "+$P{delegado}+" "+$P{delegacion}+"</style>."]]></variableExpression>
	</variable>
	<variable name="parrafo_3" class="java.lang.String">
		<variableExpression><![CDATA["<style pdfFontName='Times-Bold'>Razón:</style> Siento por tal que el día de hoy, "+new SimpleDateFormat("dd 'de' MMMMM 'de' yyyy").format(new Date())+
", notifiqué la providencia que antecede, a: "+$F{titular_actual}.replace("&","&amp;")+
", mediante boleta depositada en la casilla virtual <style pdfFontName='Times-Bold'>"+$P{casilla}+
"</style>, correspondiente a su apoderado/a "+$F{apoderado_representante_legal}.replace("&","&amp;")+
".- Lo que certifico, en virtud de la delegación de la Directora de Gestión Institucional conferida mediante Resolución Nro. "+$P{resolucionnot}+"."+
"\n\nToda contestación a la presente se la receptará exclusivamente a través del aplicativo de alcances a modificaciones correspondiente al dominio:\n\n "+
"<style pdfFontName='Times-Bold'>https://buscadores.derechosintelectuales.gob.ec/alcancesmodificaciones/login.xhtml</style>"]]></variableExpression>
	</variable>
