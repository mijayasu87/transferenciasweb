	<parameter name="tipo_mod" class="java.lang.String"/>
	<parameter name="cambio" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT a.*, 
GROUP_CONCAT(r.ro SEPARATOR ', ') AS motivo 
FROM 
$P!{tipo_mod} AS a 
INNER JOIN 
rooptions AS r ON r.solicitud = a.solicitud
WHERE 
a.id = $P{id}
GROUP BY 
a.id]]>
	</queryString>
