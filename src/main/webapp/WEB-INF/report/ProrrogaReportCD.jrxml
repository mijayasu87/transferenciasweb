	<field name="fecha_alcance" class="java.sql.Date"/>
	<field name="ape_apod_repre" class="java.lang.String"/>
	<variable name="solicitud_n" class="java.lang.String">
		<variableExpression><![CDATA[$F{solicitud}+" - ("+new SimpleDateFormat("dd 'de' MMMMM 'de' yyyy").format($F{fecha_presentacion})+")"]]></variableExpression>
	</variable>
	<variable name="notificacion_n" class="java.lang.String">
		<variableExpression><![CDATA[$F{notificacion}+"-"+java.time.LocalDate.now().getYear()]]></variableExpression>
	</variable>
	<variable name="registro_n" class="java.lang.String">
		<variableExpression><![CDATA[$F{registro}+", de ("+new SimpleDateFormat("dd 'de' MMMMM 'de' yyyy").format($F{fecha_registro})+")("+$F{signo}+")"]]></variableExpression>
	</variable>
	<variable name="parrafo_1" class="java.lang.String">
		<variableExpression><![CDATA["<style pdfFontName='Times-Bold'>SERVICIO NACIONAL DE DERECHOS INTELECTUALES - "+
"DIRECCIÓN TÉCNICA DE MODIFICACIONES AL REGISTRO.-</style> Quito, D.M., "+
new SimpleDateFormat("dd 'de' MMMMM 'de' yyyy").format($F{fecha_prorroga})+
", a las 10h30.- \n\n"]]></variableExpression>
	</variable>
	<variable name="parrafo_2" class="java.lang.String">
		<variableExpression><![CDATA["Dentro del trámite Nro. "+$F{solicitud}+", se agrega al expediente administrativo el escrito No. "+$F{numero_alcance}+", "+
"de fecha "+new SimpleDateFormat("dd 'de' MMMMM 'de' yyyy").format($F{fecha_alcance})+",  respecto de la solicitud de "+
"ampliación al término otorgado.\n\n"+
"Esta autoridad, al amparo de lo dispuesto en el art. 161 del Código Orgánico Administrativo, y encontrándose dentro del "+
"término que se encuentra recurriendo, procede a amplicar el mismo, que fue otorgado mediante Notificación No. "+
$F{notificacion}+" notificada el "+new SimpleDateFormat("dd 'de' MMMMM 'de' yyyy").format($F{fecha_notificacion})+"; "+
"esto es, el término de cinco (5) días.\n"]]></variableExpression>
	</variable>
	<variable name="parrafo_3" class="java.lang.String">
		<variableExpression><![CDATA["<style pdfFontName='Times-Bold'>Notifíquese.- </style> "+$P{nombrePersona}+", "+
"<style pdfFontName='Times-Bold'>"+$P{delegacion}+".</style>\n"]]></variableExpression>
	</variable>
	<variable name="titulo_prorroga" class="java.lang.String">
		<variableExpression><![CDATA["Resolución No. "+$F{numero_abandono}+"-"+new SimpleDateFormat("yyyy").format(new java.util.Date())+"-SENADI"]]></variableExpression>
	</variable>
	<variable name="parrafo_4" class="java.lang.String">
		<variableExpression><![CDATA["<style pdfFontName='Times-Bold'>RAZÓN.-</style> Siento por tal que el día de hoy "+
new SimpleDateFormat("dd 'de' MMMMM 'de' yyyy").format(new java.util.Date())+ ", notifiqué "+
"con la resolución que antecede a "+$F{solicitante}+", en el casillero virtual Nro. "+$F{casillero_senadi}+
"correspondiente a su apoderado/a "+$F{ape_apod_repre}+".- lo que certifico por delegación de la directora "+
"general del Servicio Nacional de Derechos Intelectuales, conferido mediante Resolución Nro. "+$P{resolucionnot}+"."]]></variableExpression>
	</variable>
